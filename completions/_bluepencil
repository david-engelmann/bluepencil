#compdef bluepencil

_bluepencil() {
    local -a subcommands
    subcommands=(
        'propose:bluepencil propose subcommand'
        'diff:bluepencil diff subcommand'
    )
    if (( CURRENT == 2 )); then
        _describe -t commands 'bluepencil subcommand' subcommands
        return
    fi
    case "${words[2]}" in
        propose) _arguments -s '-o+[file path]:file:_files' '--output=[file path]:file:_files' '-h[show help]' '--help[show help]' '*:file:_files' ;;
        diff) _arguments -s '-o+[file path]:file:_files' '--output=[file path]:file:_files' '-h[show help]' '--help[show help]' '*:file:_files' ;;
        *) _files ;;
    esac
}

_bluepencil "$@"
